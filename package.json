{
  "name": "nest-event-monitor",
  "version": "1.0.0",
  "description": "High-throughput Nest Motion Event Ingestion & Real-Time Streaming Monitor",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
